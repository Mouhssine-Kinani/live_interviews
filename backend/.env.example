# Server port (default: 3000)
PORT=3000

# Environment mode: "development" or "production"
NODE_ENV=development


# ── MongoDB ──────────────────────────────────────────────────────────────────
# Get a free cluster at https://www.mongodb.com/atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DB_URL=


# ── Inngest (Background Jobs) ────────────────────────────────────────────────
# Create an account and app at https://app.inngest.com
# Event Key  → App settings → Keys
# Signing Key → App settings → Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ── Stream (Video & Chat SDK) ────────────────────────────────────────────────
# Create an app at https://getstream.io/dashboard
STREAM_API_KEY=
STREAM_API_SECRET=


# ── Clerk (Authentication) ───────────────────────────────────────────────────
# Create an app at https://clerk.com
# Publishable Key → API Keys (safe for frontend)
# Secret Key      → API Keys (server-side only)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# ── Client URL ───────────────────────────────────────────────────────────────
# URL of the running frontend (used for CORS).
# Development: http://localhost:5173
# Production:  https://yourdomain.com
CLIENT_URL=