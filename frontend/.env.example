# ── Clerk Publishable Key ─────────────────────────────────────────────────────
# From Clerk Dashboard → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=

# ── Backend API URL ──────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://yourdomain.com
VITE_API_URL=

# ── Piston Code Execution API URL ────────────────────────────────────────────
# Development: /piston-api (Vite proxy → http://localhost:2000/api/v2)
# Production:  https://your-ngrok-url.ngrok-free.app (via ngrok tunnel)
#               or your self-hosted Piston URL
VITE_PISTON_API_URL=/piston-api