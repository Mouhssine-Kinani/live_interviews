# ── Clerk Publishable Key ─────────────────────────────────────────────────────
# From Clerk Dashboard → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=

# ── Backend API URL ──────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://yourdomain.com
VITE_API_URL=

# ── Code execution is handled by the backend via safe-eval (JS) / child_process (Python/Java)
# No extra API URL needed — the backend's /api/execute endpoint is used automatically